# Rename this file to .env and fill in values.

# ----- Brand Checkin (existing app) -----
# For Gmail: use an App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ----- Personal Health App (health/) -----
# Anthropic API key powers nutrition chat/photo logging and the morning review.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Port the health app listens on (default 3100)
HEALTH_PORT=3100

# Passcode to open the app on your phone (pick something only you know)
HEALTH_PASSCODE=change-me

# Secret used to sign your login session cookie (any long random string)
HEALTH_SECRET=please-change-this-to-a-long-random-string

# Token your iPhone uses to push Apple Health data each night.
# Put this same value in the Health Auto Export REST API automation header.
HEALTH_INGEST_TOKEN=another-long-random-string

# Your timezone, so "today" lines up with your phone (IANA name).
HEALTH_TZ=America/Los_Angeles

# Optional model overrides (defaults shown). The review uses the stronger model.
HEALTH_MODEL=claude-opus-4-8
HEALTH_CHAT_MODEL=claude-opus-4-8
