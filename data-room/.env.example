# ---------------------------------------------------------------------------
# Data Room Builder — environment configuration
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# Server
PORT=4000
# Public base URL of this app (used to build the OAuth redirect URI)
APP_BASE_URL=http://localhost:4000

# --- Google OAuth -----------------------------------------------------------
# Create an OAuth 2.0 Client (type: Web application) in the Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Enable the "Google Drive API" and "Google Docs API" for the project.
# Add this exact redirect URI to the client:
#   http://localhost:4000/auth/google/callback   (match APP_BASE_URL)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# --- Anthropic --------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to the most capable model.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Email (report delivery) ------------------------------------------------
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
# Optional: who the report appears to come from. Defaults to SMTP_USER.
REPORT_FROM=
